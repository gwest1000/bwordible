{
  "name": "mannagrams",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "test:unit": "node --test tests/*.unit.mjs",
    "test:dist": "npm run build && TEST_WEB_DIR=dist playwright test",
    "dev": "python3 -m http.server 4173",
    "start": "python3 -m http.server 4173",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.53.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2"
  }
}
